---
import { useT } from '../i18n/ui';
import { stats, type Lang } from '../data/career';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="numbers" aria-label={t('stats.aria')}>
  <div class="container numbers__inner">
    <p class="numbers__value" data-reveal>
      <span data-count={stats.journeyYears}>{stats.journeyYears}</span>
      <sup>+</sup>
    </p>
    <p class="numbers__label" data-reveal>{t('stats.journey')}</p>
    <a class="numbers__cta" href="#destaques" data-reveal>
      {t('stats.cta')}
      <i aria-hidden="true"></i>
    </a>
  </div>
</section>

<style>
  .numbers {
    padding: clamp(72px, 12vw, 140px) 0 clamp(56px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
  }
  .numbers__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .numbers__value {
    margin: 0;
    font-size: clamp(120px, 22vw, 260px);
    font-weight: 200;
    letter-spacing: -0.06em;
    line-height: 0.9;
    /* dígitos proporcionais + compensação do respiro do glifo: o "1" encosta no eixo do texto */
    margin-left: -0.05em;
  }
  .numbers__value sup {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
    font-size: 0.4em;
    vertical-align: top;
    margin-left: -0.02em;
  }
  .numbers__label {
    margin: 20px 0 0;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .numbers__cta {
    margin-top: 48px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 10.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .numbers__cta:hover,
  .numbers__cta:focus-visible {
    color: var(--accent);
  }
  .numbers__cta i {
    position: relative;
    order: -1;
    width: 1px;
    height: 44px;
    overflow: hidden;
  }
  .numbers__cta i::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--accent), transparent);
    animation: drop 2s var(--ease) infinite;
  }
  @keyframes drop {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .numbers__cta i::before {
      animation: none;
    }
  }
</style>
