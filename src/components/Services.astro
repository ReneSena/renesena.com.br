---
import { useT, emph } from '../i18n/ui';
import type { Lang } from '../data/career';
import { services, formats } from '../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section services" id="servicos">
  <div class="container">
    <p class="eyebrow" data-reveal>{t('services.label')}</p>
    <h2 class="display" data-reveal set:html={emph(t('services.title'))} />
    <p class="lead services__intro" data-reveal>{t('services.intro')}</p>

    <div class="services__grid">
      {
        services.map((s, i) => (
          <article class="service" data-reveal>
            <span class="service__num" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{s.title[lang]}</h3>
            <p class="service__pain">{s.pain[lang]}</p>
            <ul>
              {s.items[lang].map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="formats" data-reveal>
      <p class="formats__label">{t('services.formats')}</p>
      <dl>
        {
          formats.map((f) => (
            <div>
              <dt>{f.title[lang]}</dt>
              <dd>{f.text[lang]}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <a
      class="pill pill--solid services__cta"
      href="#contato"
      data-contact-type="freelance"
      data-magnetic
      data-reveal
      data-umami-event="services_cta">{t('services.cta')} →</a
    >
  </div>
</section>

<style>
  .services {
    border-top: 1px solid var(--border);
  }
  .services .display {
    font-size: clamp(36px, 5.5vw, 76px);
    max-width: 16ch;
  }
  .services__intro {
    margin-top: 24px;
  }
  .services__grid {
    margin-top: clamp(48px, 8vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .service {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.4s;
  }
  .service:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
  }
  .service__num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 40px;
    line-height: 0.8;
    color: var(--accent-display);
  }
  .service h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .service__pain {
    margin: 0;
    font-size: 15px;
    font-style: italic;
    color: var(--text-muted);
  }
  .service ul {
    list-style: none;
    margin: 4px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 8px;
    font-size: 14.5px;
  }
  .service li {
    position: relative;
    padding-left: 20px;
  }
  .service li::before {
    content: '✦';
    content: '✦' / '';
    position: absolute;
    left: 0;
    top: 0.45em;
    color: var(--accent);
    font-size: 9px;
    line-height: 1;
  }

  .formats {
    margin-top: 56px;
    display: grid;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .formats__label {
    margin: 0;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .formats dl {
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .formats dt {
    font-weight: 500;
  }
  .formats dd {
    margin: 4px 0 0;
    font-size: 14.5px;
    color: var(--text-muted);
  }
  .services__cta {
    margin-top: 40px;
  }

  @media (min-width: 701px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .formats dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
