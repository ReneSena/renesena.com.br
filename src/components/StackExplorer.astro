---
import { useT, emph } from '../i18n/ui';
import { stack } from '../data/stack';
import { techIcon } from '../data/icons';
import { stats, type Lang } from '../data/career';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// Anéis: do interno (Base) ao externo (Fluxo); sentidos alternados, mais lentos por fora
const rings = stack.map((g, i) => ({
  ...g,
  index: i,
  duration: 60 + i * 18,
  reverse: i % 2 === 1,
  offset: i * 37, // desalinha os ícones entre anéis
  items: g.items.map((tech) => ({ tech, ...techIcon(tech) })),
}));
---

<section class="section stack" id="stack" data-anim-zone>
  <div class="container stack__grid">
    <div class="stack__intro">
      <p class="eyebrow" data-reveal>{t('stack.label')}</p>
      <h2 class="display stack__title" data-reveal set:html={emph(t('stack.title'))} />
      <p class="lead" data-reveal>{t('stack.hint')}</p>
      <ul class="legend" data-reveal>
        {
          rings.map((r) => (
            <li>
              <span class="legend__ring" style={`--i:${r.index}`} />
              {r.label[lang]}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="planet" aria-hidden="true">
      <div class="planet__system" data-system>
        <span class="planet__core" aria-hidden="true"></span>
        {
          rings.map((r) => (
            <div
              class:list={['ring', { 'ring--reverse': r.reverse }]}
              style={`--i:${r.index};--dur:${r.duration}s;--n:${r.items.length}`}
            >
              <div class="ring__spin">
                {r.items.map((it, k) => (
                  <div class="orbit-item" style={`--a:${(360 / r.items.length) * k + r.offset}deg`}>
                    <span class="orbit-btn">
                      <span class="orbit-btn__icon" set:html={it.svg} />
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }

      </div>
      <div class="center">
        <p class="center__big">{stats.techs}+</p>
        <p class="center__label">{t('stack.count')}</p>
      </div>
    </div>
  </div>

  <!-- Lista acessível / sem JS -->
  <div class="sr-only">
    <h3>{t('stack.list')}</h3>
    {
      stack.map((g) => (
        <>
          <h4>{g.label[lang]}</h4>
          <ul>
            {g.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </>
      ))
    }
  </div>
</section>

<style>
  .stack {
    overflow: hidden;
  }

  /* ---------- layout (mobile-first) ---------- */
  .stack__grid {
    display: grid;
    gap: 40px;
  }
  .stack__intro {
    display: grid;
    gap: 22px;
  }
  .stack__intro .eyebrow {
    margin: 0;
  }
  .stack__title {
    font-size: clamp(36px, 5vw, 68px);
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .legend__ring {
    width: calc(8px + var(--i) * 3px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed var(--text-muted);
  }

  /* ---------- sistema planetário ---------- */
  .planet {
    --bubble: 38px;
    position: relative;
  }
  .planet__system {
    position: relative;
    width: 100%;
    max-width: 680px;
    aspect-ratio: 1;
    margin: 0 auto;
    /* raio de cada anel, como fração do raio total */
    --r0: 0.3;
    --step: 0.155;
  }
  .planet__core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--accent) 55%, #fff), var(--accent) 55%, var(--accent-ink));
    box-shadow:
      0 0 0 10px color-mix(in srgb, var(--accent) 10%, transparent),
      0 0 60px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc((var(--r0) + var(--i) * var(--step)) * 100%);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--text-muted) 45%, transparent);
    pointer-events: none;
  }
  .ring__spin {
    position: absolute;
    inset: 0;
    animation: orbit var(--dur) linear infinite;
  }
  .ring--reverse .ring__spin {
    animation-direction: reverse;
  }
  .orbit-item {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    /* raio = metade da largura do anel (container query) */
    transform: rotate(var(--a)) translateX(50cqw);
  }
  .ring__spin {
    container-type: size;
  }
  .orbit-btn {
    position: absolute;
    left: calc(var(--bubble) / -2);
    top: calc(var(--bubble) / -2);
    width: var(--bubble);
    height: var(--bubble);
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    display: grid;
    place-items: center;
    /* desfaz a rotação do anel para o ícone ficar de pé */
    transform: rotate(calc(var(--a) * -1));
  }
  .orbit-btn__icon {
    display: grid;
    place-items: center;
    width: 50%;
    height: 50%;
    animation: orbit var(--dur) linear infinite reverse;
  }
  .ring--reverse .orbit-btn__icon {
    animation-direction: normal;
  }
  .orbit-btn__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  @keyframes orbit {
    to {
      rotate: 360deg;
    }
  }

  /* ---------- painel central (mobile: cartão abaixo) ---------- */
  .center {
    position: relative;
    margin-top: 20px;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elev);
    text-align: center;
  }
  .center p {
    margin: 0;
  }
  .center__big {
    font-size: 44px;
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .center__label {
    margin-top: 6px !important;
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .ring__spin,
    .orbit-btn__icon {
      animation: none;
    }
  }

  /* ---------- tablet+ : painel dentro do sistema ---------- */
  @media (min-width: 701px) {
    .planet {
      --bubble: 46px;
    }
    .planet__system {
      --r0: 0.44;
      --step: 0.125;
    }
    .planet__core {
      display: none;
    }
    .center {
      position: absolute;
      left: 50%;
      top: 50%;
      width: calc(min(100%, 680px) * 0.3);
      aspect-ratio: 1;
      min-height: 0;
      margin: 0;
      padding: 8%;
      translate: -50% -50%;
      border-radius: 50%;
      display: grid;
      place-content: center;
      background: radial-gradient(circle at 50% 30%, var(--bg-elev), var(--accent-soft));
      border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
      box-shadow: 0 0 80px color-mix(in srgb, var(--accent) 22%, transparent);
    }
    .center__big {
      font-size: clamp(36px, 4.4vw, 56px);
    }
  }

  @media (min-width: 961px) {
    .stack__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(40px, 5vw, 80px);
      align-items: center;
    }
  }
</style>

