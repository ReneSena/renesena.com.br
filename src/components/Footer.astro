---
import { useT, site } from '../i18n/ui';
import type { Lang } from '../data/career';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">© {year} RENE SENA</p>
    <p class="footer__made">{t('footer.made')}</p>
    <div class="footer__links">
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a href="#top" data-to-top>{t('footer.top')} ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 28px 0 36px;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }
  /* mobile: uma coluna com ritmo fixo; desktop: três colunas alinhadas (sem quebra em zigue-zague) */
  .footer__inner {
    display: grid;
    gap: 12px;
    justify-items: start;
    align-items: center;
  }
  .footer p {
    margin: 0;
  }
  .footer__made {
    letter-spacing: 0.04em;
    font-size: 12px;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    /* a área de toque de 44px não deve somar espaço visual */
    margin-block: -12px;
  }
  @media (min-width: 861px) {
    .footer__inner {
      grid-template-columns: 1fr auto 1fr;
      gap: 24px;
    }
    .footer__links {
      justify-self: end;
    }
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .footer a:hover {
    color: var(--accent-ink);
  }
</style>

<script>
  import { getLenis } from '../scripts/motion';
  document.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const lenis = getLenis();
    if (lenis) lenis.scrollTo(0);
    else window.scrollTo({ top: 0 });
  });
</script>
