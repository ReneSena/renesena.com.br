---
import Base from '../layouts/Base.astro';
import Numbers from './Numbers.astro';
import Highlights from './Highlights.astro';
import Timeline from './Timeline.astro';
import StackExplorer from './StackExplorer.astro';
import ContactCta from './ContactCta.astro';
import { useT, journeyPath } from '../i18n/ui';
import type { Lang } from '../data/career';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<Base lang={lang} title={t('journey.pageTitle')} description={t('journey.pageDesc')} altPath={journeyPath(lang === 'pt' ? 'en' : 'pt')}>
  <div class="journey-page">
    <h1 class="sr-only">{t('journey.pageTitle')}</h1>
    <Numbers lang={lang} />
    <Highlights lang={lang} />
    <Timeline lang={lang} />
    <StackExplorer lang={lang} />
    <ContactCta lang={lang} from="journey" text={t('cta.journey')} />
  </div>
</Base>

<style>
  .journey-page {
    padding-top: 72px;
  }
</style>
